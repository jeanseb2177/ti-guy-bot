# Copier ce fichier en .env (local) ou configurer ces variables dans Railway → Variables
# NE JAMAIS commiter de vraies valeurs dans ce fichier ni ailleurs dans le code.

# Anthropic (génération de scripts)
ANTHROPIC_API_KEY=

# Shopify (catalogue reel de moncampdebase.com — les revues produit piochent dedans
# au lieu d'improviser un nom de produit generique)
# SHOPIFY_STORE_DOMAIN: le domaine *.myshopify.com de la boutique (pas moncampdebase.com)
# SHOPIFY_STOREFRONT_TOKEN: jeton Storefront API (lecture seule) — Admin Shopify > Parametres
# > Apps et canaux de vente > Developper des applications > creer une app > activer
# la Storefront API avec le scope unauthenticated_read_product_listings
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# ElevenLabs (génération audio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# HeyGen (optionnel, non utilisé dans le pipeline actuel)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Cloudinary (hébergement des vidéos finales)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram (notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostPeer (publication automatique TikTok/Instagram)
POSTPEER_API_KEY=
# Format: platform:accountId,platform:accountId (voir GET /api/postpeer/integrations)
POSTPEER_ACCOUNTS=

# Dashboard
DASHBOARD_PASSWORD=

# Serveur
PORT=3000
