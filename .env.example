# Copier ce fichier en .env (local) ou configurer ces variables dans Railway → Variables
# NE JAMAIS commiter de vraies valeurs dans ce fichier ni ailleurs dans le code.

# Anthropic (génération de scripts)
ANTHROPIC_API_KEY=

# Kling AI (génération vidéo)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ElevenLabs (génération audio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# HeyGen (optionnel, non utilisé dans le pipeline actuel)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Cloudinary (hébergement des vidéos finales)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram (notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostPeer (publication automatique TikTok/Instagram)
POSTPEER_API_KEY=
# Format: platform:accountId,platform:accountId (voir GET /api/postpeer/integrations)
POSTPEER_ACCOUNTS=

# Dashboard
DASHBOARD_PASSWORD=

# Serveur
PORT=3000
